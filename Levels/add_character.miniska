# Adds a character to the map
# Arguments : sprite, block x, block y, name, script run when the player talks to the character, then its arguments
Game = import "bind:game"

run = function(args: string[]) do
	script = ""
	if args.size() > 4
		script = args[4]
	end
	scriptArguments = []: string
	for(i = 5
	 i < args.size()
	 i = i + 1) do
		scriptArguments = scriptArguments + args[i]
	end
	Game.addCharacter((args[0]: int), (args[1]: int), (args[2]: int), args[3], script, scriptArguments)
end
