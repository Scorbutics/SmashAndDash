# Arrival in Cramois'ile : visit of the island, then Dr. Loufok takes the player to his lab
Engine = import "bind:ska.engine"
Game = import "bind:game"
Story = import "wd:Levels/story"

run = function(args: string[]) do
	if Story.done(1) == false
		Engine.disableComponent(Story.npc(2, 0), "GraphicComponent")
		Game.follow(Story.player(), Story.npc(4, 0))
		Game.follow(Story.npc(6, 0), Story.npc(4, 0))
		Game.follow(Story.npc(5, 0), Story.npc(7, 0))
		Game.follow(Story.npc(4, 0), Story.npc(7, 0))
		Game.message("Bonjour et bienvenue pour le départ vers une nouvelle année !")
		Game.message("Avant de démarrer les cours, certains ne connaissent surement pas encore l'île.¤Je vais donc en faire une brève visite.")
		Game.message("Il y a devant nous le labo du Dr. Loufok.¤Je vous déconseille de traîner ici trop longtemps ou ce vieux cinglé viendra vous utiliser comme cobaye !")
		Story.walk(Story.npc(7, 0), 0, 3)
		Story.walk(Story.npc(7, 0), 1, 2)
		Story.walk(Story.npc(7, 0), 0, 3)
		Engine.wait(500)
		Game.setDirection(Story.npc(7, 0), 2)
		Game.message("Voici en bas le batiment de l'école.¤C'est ici que nous suivrons les cours.")
		Story.walk(Story.npc(7, 0), 1, 6)
		Story.walk(Story.npc(7, 0), 2, 6)
		Story.walk(Story.npc(7, 0), 1, 3)
		Story.walk(Story.npc(7, 0), 2, 4)
		Story.walk(Story.npc(7, 0), 1, 10)
		Engine.wait(500)
		Game.setDirection(Story.npc(7, 0), 3)
		Game.message("Cramois'ile est une île volcanique.¤En son centre se situe un volcan.¤Ne vous inquiétez pas, il n'est plus actif, haha ! Ahem !")
		Story.walk(Story.npc(7, 0), 1, 3)
		Engine.wait(500)
		Game.setDirection(Story.npc(7, 0), 3)
		Game.message("Ici, voici l'ancien sanctuaire du feu.¤Il contient des statues de créatures anciennement vénérées comme des dieux.")
		Engine.enableComponent(Story.npc(2, 0), "GraphicComponent")
		Game.place(Story.npc(2, 0), 9, 19)
		Story.walk(Story.npc(2, 0), 1, 2)
		Game.message("Hé ! Votre vieux cinglé, il s'y connaît très bien concernant le sanctuaire en attendant !")
		Story.walk(Story.npc(2, 0), 1, 12)
		Engine.wait(500)
		Game.setDirection(Story.player(), 3)
		Game.message("Dis-moi ma chère, je viens chercher le gamin,¤je te le rapporterai plus tard, j'ai besoin¤de lui parler un peu seul à seul. HIN HIN HINHIN !")
		Game.follow(Story.player(), Story.npc(2, 0))
		Game.follow(Story.npc(6, 0), -1)
		Game.follow(Story.npc(5, 0), -1)
		Game.follow(Story.npc(4, 0), -1)
		Engine.wait(2000)
		Story.walk(Story.npc(2, 0), 3, 6)
		Engine.wait(500)
		Game.setDirection(Story.npc(2, 0), 1)
		Game.message("Alors voilà, je t'explique le topo. Tu sais bien que le Professeur Coss et moi étions très proches.¤Je crois savoir la raison de sa disparition.")
		Game.message("Tu vois, un peu avant son expédition au temple Koa,¤nous avions discuté des étranges séismes qui s'amplifiaient avec le temps.")
		Game.message("Je pense qu'il a fini par partager mon opinion... HIN HIN !¤Pour résumer, j'étudie actuellement une forme de vie disparue.¤Les statues dans le sanctuaire du feu en sont des représentations.")
		Game.message("Il y a apparemment une source à cette forme de vie.¤En gros, c'est la créature originelle qui a provoqué l'apparition des autres.")
		Game.message("Les seuls restes que nous ayions de ces créatures sont les fossiles dans mon labo.¤Malheureusement, personne ne souhaite écouter ma théorie.¤Les gens préfèrent se concentrer sur ce qu'ils voient.")
		Game.message("Le Professeur Coss est parti avec son assistante explorer la grotte à l'origine des séismes.¤Il a dû se faire capturer par la créature originelle...")
		Story.walk(Story.npc(2, 0), 3, 2)
		Engine.wait(500)
		Game.setDirection(Story.npc(2, 0), 1)
		Game.message("Allez, viens dans mon labo, je vais te montrer à quoi ressemble le fossile que j'ai dernièrement trouvé !")
		Game.message("Quoi ? Les cours ? La prof ? Bah qu'est ce que tu racontes,¤ je l'ai prévenue, laisse tomber pour l'instant !¤En plus, je crois qu'elle me trouve séduisant. HIN HIN HINHIN !")
		Story.walk(Story.npc(2, 0), 3, 9)
		Story.walk(Story.npc(2, 0), 2, 2)
		Game.follow(Story.player(), -1)
		# (Done before leaving the map : the characters of this map are removed with it)
		Story.setDone(1)
		Game.teleport("cramoisile_labo", 11, 6)
	end
end
