# Dr. Loufok takes the other relic, then everyone leaves for Greencity
Engine = import "bind:ska.engine"
GameDialog = import "bind:game.dialog"
Character = import "bind:game.character"
Map = import "bind:game.map"
Party = import "bind:game.party"
Story = import "wd:Levels/story"

run = function(args: string[]) do
	# Relic chosen by the player (1 : Kabuto, 0 : Amonita)
	if Engine.variable("starterChoice") == 1
		Character.remove(Story.npc(11, 0))
	else
		Story.walk(Story.npc(2, 0), 2, 1)
		Character.remove(Story.npc(11, 1))
	end
	Character.setDirection(Story.npc(2, 0), 3)
	GameDialog.message("Je prends donc celui-ci !")
	Character.setDirection(Story.npc(2, 0), 0)
	Party.pokemonOut(0)
	GameDialog.message("OHHH ! OUAAHH ! Une créature ! Mais mais... c'est un monstre... tout petit,¤ il rentrerait dans une poche...¤On pourrait appeler ça un Pocket Monster non ? ... ¤Euuh... Bah, quelle idée débile HIN HIN HIN laisse tomber !")
	GameDialog.message("Bon, les choses prennent une tournure inquiétante. ¤Je dois aussi avoir un de ces monstre dans ma ball.")
	GameDialog.message("Bref, allons-y, partons dès maintenant ! Un bateau nous attend, ¤il va nous emmener à Greencity.¤C'est la première étape de notre périple. Un ami à moi habite là-bas.¤ Je vais lui montrer notre découverte.")
	Map.teleport("greencity", 20, 10)
end
