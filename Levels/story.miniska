# Story helpers : Story = import "wd:Levels/story"
Engine = import "bind:ska.engine"
Character = import "bind:game.character"

Block = 48

# Player
player = function() : int do
	return Engine.entity("trainer")
end

# Character of a map with the sprite "pnj<number>" (sprite -<number>) : added with the name "npc-<number>_<index>"
# (index : among the characters of the map with this sprite, see the map event files)
npc = function(number: int, index: int) : int do
	return Engine.entity("npc-" + number + "_" + index)
end

# Walks a number of blocks in a direction (0 : down, 1 : right, 2 : up, 3 : left)
walk = function(entity: int, direction: int, blocks: int) do
	Character.move(entity, direction, blocks * Block, false)
end

# Story steps done (saved with the game)
done = function(step: int) : bool do
	return Engine.variable("story" + step) == 1
end

setDone = function(step: int) do
	Engine.setVariable("story" + step, 1)
end
