# Introduction : Professor Coss and Noemie in the Koa temple
Engine = import "bind:ska.engine"
GameDialog = import "bind:game.dialog"
Character = import "bind:game.character"
Map = import "bind:game.map"
Interface = import "bind:game.interface"
Story = import "wd:Levels/story"

run = function(args: string[]) do
	Interface.hideInterface(true)
	Engine.disableComponent(Story.player(), "GraphicComponent")
	Engine.disableComponent(Story.player(), "InputComponent")
	GameDialog.cinematic(17, "Bienvenue dans le monde de Pokémon !")
	GameDialog.cinematic(17, "Je suis le Professeur Coss, nom de code Coss222.¤Ma profression est l'étude des Pokémon.¤Un Pokémon est une créature domesticable vivant en compagnie de l'homme. Voici par exemple un Nidoran mâle.")
	GameDialog.cinematic(17, "Pour connaître l'origine et la provenance de ces créatures, il faut remonter légèrement le temps !¤Trève de bavardages, et sans plus attendre, revis l'expérience avec moi !")
	Character.setDirection(Story.npc(3, 0), 3)
	Character.setDirection(Story.npc(2, 0), 1)
	Map.crumbling(3000)
	Map.shake(3000, 20)
	Engine.wait(500)
	Character.setDirection(Story.npc(3, 0), 0)
	Character.setDirection(Story.npc(2, 0), 2)
	Engine.wait(500)
	Character.setDirection(Story.npc(3, 0), 1)
	Character.setDirection(Story.npc(2, 0), 3)
	Engine.wait(500)
	Character.setDirection(Story.npc(3, 0), 3)
	Character.setDirection(Story.npc(2, 0), 1)
	Engine.wait(500)
	Character.setDirection(Story.npc(3, 0), 2)
	Character.setDirection(Story.npc(2, 0), 0)
	Engine.wait(2000)
	GameDialog.message("Ouf! *Tousse* kof kof... professeur vous ¤n'avez rien ?! Ce n'est pas normal....")
	Story.walk(Story.npc(2, 0), 0, 4)
	Story.walk(Story.npc(2, 0), 1, 4)
	Story.walk(Story.npc(2, 0), 2, 2)
	GameDialog.message("Aïe ! Ca peut aller. Que se passe t-il Noémie ?¤ On aurait dit des secousses sismiques... C'est étrange, ¤nous ne sommes pourtant pas dans une zone à risque.")
	GameDialog.message("Vous deviez avoir raison à propos de votre théorie...")
	GameDialog.message("A quoi pensez-vous ?")
	Map.shake(1000, 20)
	Engine.wait(1000)
	Character.setDirection(Story.npc(3, 0), 2)
	Character.setDirection(Story.npc(2, 0), 2)
	GameDialog.message("Ohh non ! Comment a-t-il pu survivre ? ¤S'il nous trouve nous sommes perdus !")
	Character.playAnimation(Story.npc(2, 0), 2)
	Engine.wait(500)
	GameDialog.message("Noémie !!! Attention !!")
	Character.setDirection(Story.npc(3, 0), 1)
	Map.shake(1000, 20)
	Engine.wait(1000)
	GameDialog.message("?! AHH ! ...")
	Engine.enableComponent(Story.player(), "InputComponent")
	Interface.hideInterface(false)
	Engine.enableComponent(Story.player(), "GraphicComponent")
	Map.teleport("cramoisile", 11, 20)
	# (old script, disabled) teleporter 0 0 maison_hero.bmp/maison_heroD.bmp/maison_heroE.txt/7:5
end
