# Pokemon center nurse
GameDialog = import "bind:game.dialog"
Party = import "bind:game.party"

run = function(args: string[]) do
	GameDialog.message("Bienvenue au centre Pokémon !")
	GameDialog.message("Je vais soigner tes Pokémon.")
	for(i = 0
	 i < 6
	 i = i + 1) do
		Party.heal(i, 999)
	end
	GameDialog.message("Tes Pokémon sont soignés. Merci de ton attente !")
end
