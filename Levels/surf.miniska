# Surfing : Surf = import "wd:Levels/surf"
Engine = import "bind:ska.engine"
Character = import "bind:game.character"
Map = import "bind:game.map"

# Block property of the water
Water = 1

# The player is on the water
surfing = false
# The player is going on / leaving the water
moving = false

# Moves the player onto the water, or back to the ground, in a direction
enter = function(player: int, direction: int) do
	if moving
		return
	end
	moving = true
	Engine.disableComponent(player, "InputComponent")
	if surfing
		Character.setLayer(player, 1)
		Engine.log("surf out")
	else
		Character.setLayer(player, 0)
		Engine.log("surf in")
	end
	Character.playAnimation(player, 2)
	Character.move(player, direction, 40, false)
	surfing = Map.blockHasProperty(0, Map.blockX(player), Map.blockY(player), Water)
	Engine.enableComponent(player, "InputComponent")
	moving = false
end
