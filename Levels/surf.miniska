# Surfing : Surf = import "wd:Levels/surf"
Engine = import "bind:ska.engine"
Character = import "bind:game.character"
Map = import "bind:game.map"

# Block property of the water
Water = 1
# Sprites of the player : walking (Sprites/Charsets/0.png, made by tools/tilegen/character.py), surfing (made from it by
# tools/assets/surf_sprite.py)
HeroSprite = 0
SurfSprite = 1000

# The player is on the water
surfing = false
# The player is going on / leaving the water
moving = false

# The block next to the player in a direction (0 down, 1 right, 2 up, 3 left), on one axis
nextX = function(player: int, direction: int) : int do
	if direction == 1
		return Map.blockX(player) + 1
	end
	if direction == 3
		return Map.blockX(player) - 1
	end
	return Map.blockX(player)
end

nextY = function(player: int, direction: int) : int do
	if direction == 0
		return Map.blockY(player) + 1
	end
	if direction == 2
		return Map.blockY(player) - 1
	end
	return Map.blockY(player)
end

# Moves the player onto the water, or back to the ground, in a direction
enter = function(player: int, direction: int) do
	if moving || direction < 0 || direction > 3
		return
	end
	# The block in front : free (no wall, no character), and the ground when leaving the water
	x = nextX(player, direction)
	y = nextY(player, direction)
	if !Map.blockFree(x, y) || (surfing && Map.blockHasProperty(0, x, y, Water))
		return
	end
	moving = true
	Engine.disableComponent(player, "InputComponent")
	if surfing
		Character.setLayer(player, 1)
		# Jumps off the water Pokemon
		Character.setSprite(player, HeroSprite, false)
		Engine.log("surf out")
	else
		Character.setLayer(player, 0)
		Engine.log("surf in")
	end
	Character.playAnimation(player, 2)
	# One block, on the blocks of the map
	Character.step(player, direction, 1)
	surfing = Map.blockHasProperty(0, Map.blockX(player), Map.blockY(player), Water)
	if surfing
		# On its water Pokemon, bobbing on the water
		Character.setSprite(player, SurfSprite, true)
	end
	Engine.enableComponent(player, "InputComponent")
	moving = false
end
