# The bond between the trainer and its Pokemon during a battle : a gauge (0 .. 100) that fills when something happens
# (the events of Data/Battle/lines.miniska, and "encourage" : the trainer said a line). Full, the player unleashes the
# strongest skill of its Pokemon (a cinematic : the battle stops, the trainer calls the skill, a ring closes on the
# Pokemon : pressed when it closes, the hit is perfect). Called by the battle (it cannot wait).

# How much an event fills the gauge (the other events : not at all)
Gains = [
	"hit": 6,
	"super": 12,
	"weak": 3,
	"hurt": 9,
	"low": 25,
	"dodge": 10,
	"encourage": 5
]

gain = function(event: string) : int do
	return Gains.get(event, 0)
end

# The damage of the skill unleashed (percents of its usual damage), more for a perfect timing
power = function(perfect: bool) : int do
	if perfect
		return 300
	end
	return 200
end
