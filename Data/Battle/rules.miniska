# Battle rules : the battle asks these functions for values, during the battle (they cannot wait).
# When a function fails, the battle logs the error and uses a default value.

Math = import "bind:std.native.math"

# Statistic of a Pokemon at a level, from its base statistic ([BaseStats] of Data/Monsters/<id>.ini)
stat = function(base: int, level: int) : int do
	return 2 * base * level / 100 + 5
end

# Hit points of a Pokemon at a level, from its base hit points. Twice the usual value : a real time battle lasts
# about 20 seconds (a dozen hits for each fighter)
maxHp = function(baseHp: int, level: int) : int do
	return 2 * (2 * baseHp * level / 100 + level + 10)
end

# Level of a Pokemon from its experience ("needed" : the experience needed for each level, [Experience] level_1_exp_needed)
level = function(experience: int, needed: int) : int do
	if needed <= 0
		return 1
	end
	return Math.clamp(1 + experience / needed, 1, 100)
end

# The experience of a Pokemon when it reaches a level (the start of the level : "level" above), "needed" as above
levelExperience = function(level: int, needed: int) : int do
	if needed <= 0 || level <= 1
		return 0
	end
	return (level - 1) * needed
end

# Experience won by defeating a Pokemon ("dropped" : [Experience] level_1_exp_dropped of the defeated Pokemon) of a level
experience = function(dropped: int, level: int) : int do
	return dropped * level
end

# Types : how much a skill of a type hurts a Pokemon of a type (percents), when it is not 100
chart = [:]: int
relation = function(attack: string, defenders: string[], percent: int) do
	defenders | (defender) do
		chart[attack + ">" + defender] = percent
	end
end
relation("Normal", ["Roche", "Acier"], 50)
relation("Normal", ["Spectre"], 0)
relation("Feu", ["Plante", "Glace", "Insecte", "Acier"], 200)
relation("Feu", ["Feu", "Eau", "Roche", "Dragon"], 50)
relation("Eau", ["Feu", "Sol", "Roche"], 200)
relation("Eau", ["Eau", "Plante", "Dragon"], 50)
relation("Plante", ["Eau", "Sol", "Roche"], 200)
relation("Plante", ["Feu", "Plante", "Poison", "Vol", "Insecte", "Dragon", "Acier"], 50)
relation("Electrique", ["Eau", "Vol"], 200)
relation("Electrique", ["Electrique", "Plante", "Dragon"], 50)
relation("Electrique", ["Sol"], 0)
relation("Glace", ["Plante", "Sol", "Vol", "Dragon"], 200)
relation("Glace", ["Feu", "Eau", "Glace", "Acier"], 50)
relation("Combat", ["Normal", "Glace", "Roche", "Tenebres", "Acier"], 200)
relation("Combat", ["Poison", "Vol", "Psy", "Insecte", "Fee"], 50)
relation("Combat", ["Spectre"], 0)
relation("Poison", ["Plante", "Fee"], 200)
relation("Poison", ["Poison", "Sol", "Roche", "Spectre"], 50)
relation("Poison", ["Acier"], 0)
relation("Sol", ["Feu", "Electrique", "Poison", "Roche", "Acier"], 200)
relation("Sol", ["Plante", "Insecte"], 50)
relation("Sol", ["Vol"], 0)
relation("Vol", ["Plante", "Combat", "Insecte"], 200)
relation("Vol", ["Electrique", "Roche", "Acier"], 50)
relation("Psy", ["Combat", "Poison"], 200)
relation("Psy", ["Psy", "Acier"], 50)
relation("Psy", ["Tenebres"], 0)
relation("Insecte", ["Plante", "Psy", "Tenebres"], 200)
relation("Insecte", ["Feu", "Combat", "Poison", "Vol", "Spectre", "Acier", "Fee"], 50)
relation("Roche", ["Feu", "Glace", "Vol", "Insecte"], 200)
relation("Roche", ["Combat", "Sol", "Acier"], 50)
relation("Spectre", ["Psy", "Spectre"], 200)
relation("Spectre", ["Tenebres"], 50)
relation("Spectre", ["Normal"], 0)
relation("Dragon", ["Dragon"], 200)
relation("Dragon", ["Acier"], 50)
relation("Dragon", ["Fee"], 0)
relation("Tenebres", ["Psy", "Spectre"], 200)
relation("Tenebres", ["Combat", "Tenebres", "Fee"], 50)
relation("Acier", ["Glace", "Roche", "Fee"], 200)
relation("Acier", ["Feu", "Eau", "Electrique", "Acier"], 50)
relation("Fee", ["Combat", "Dragon", "Tenebres"], 200)
relation("Fee", ["Feu", "Poison", "Acier"], 50)

# Effectiveness of a skill of the type "skillType" on a Pokemon of the types "type1" and "type2" ("Aucun" : no second
# type), in percents : 0 (no effect), 25, 50, 100, 200, 400
effectiveness = function(skillType: string, type1: string, type2: string) : int do
	percent = 100
	[type1, type2] | (defender) do
		key = skillType + ">" + defender
		if chart.has(key)
			percent = percent * chart[key] / 100
		end
	end
	return percent
end

# Damage of a skill ("power" : [Particle] damage of the skill) hitting a Pokemon : "attack" of the attacker, "defense"
# of the target (the special statistics for a special skill, their changes in the battle included), "level" of the
# attacker, "effectiveness" of the type of the skill (percents), "stab" : the skill has a type of the attacker (+50%).
# At least 1 damage when the skill has power and an effect
damage = function(power: int, attack: int, defense: int, level: int, effectiveness: int, stab: bool) : int do
	# A skill without power (ex : a status skill) does no damage
	if power <= 0 || effectiveness <= 0
		return 0
	end
	if defense < 1
		defense = 1
	end
	base = (2 * level / 5 + 2) * power * attack / defense / 12
	if stab
		base = base * 3 / 2
	end
	return Math.max(1, base * effectiveness / 100)
end

# Damage of a hit given by a wild Pokemon (the player has one Pokemon against the wild ones : they hit a little softer)
wildDamage = function(damage: int) : int do
	if damage <= 0
		return 0
	end
	return Math.max(1, damage * 3 / 4)
end

# Chance (percents, 1 .. 100) to capture a wild Pokemon with a pokeball : "rate" its capture rate ([Description]
# capture_rate of Data/Monsters/<id>.ini, 3 .. 255), its hit points, its status ("none", "poison", "burn", "paralysis",
# "sleep", "leech"). Easier when it is hurt (from a third at full hit points to all of it near 0, for the highest rate),
# asleep (x2) or with another status (x1.5)
captureChance = function(rate: int, hp: int, maxHp: int, status: string) : int do
	if maxHp < 1
		maxHp = 1
	end
	odds = (3 * maxHp - 2 * Math.clamp(hp, 0, maxHp)) * Math.clamp(rate, 1, 255) * 100 / (3 * maxHp * 255)
	if status == "sleep"
		odds = odds * 2
	end
	if ["poison", "burn", "paralysis", "leech"].contains(status)
		odds = odds * 3 / 2
	end
	return Math.clamp(odds, 1, 100)
end
