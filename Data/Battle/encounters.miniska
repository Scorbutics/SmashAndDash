# The encounters with the wild Pokemon, asked by the map (they cannot wait). The dice are rolled by the game with the
# sizes given here (the replays stay the same). A battle starts when the trainer and a wild Pokemon touch : one walks
# into the other.

# The attitude of a wild Pokemon on the map, decided when it appears : "aggressive" (it charges the player in sight),
# "fearful" (it runs away from the player), "passive" (it wanders, the player walks into it to fight). "level" : its
# level, "teamLevel" : the level of the first Pokemon of the team able to fight, "roll" : 0 .. 99.
# Stronger than the team : more often aggressive ; weaker : more often fearful.
attitude = function(monster: int, level: int, teamLevel: int, roll: int) : string do
	gap = level - teamLevel
	aggressive = 30 + 10 * gap
	if aggressive < 10
		aggressive = 10
	end
	if aggressive > 70
		aggressive = 70
	end
	fearful = 30 - 10 * gap
	if fearful < 10
		fearful = 10
	end
	if fearful > 60
		fearful = 60
	end
	if roll < aggressive
		return "aggressive"
	end
	if roll < aggressive + fearful
		return "fearful"
	end
	return "passive"
end

# The wild Pokemon is not alone : 1 time in "groupOdds", "groupSize" others of its kind join it
groupOdds = function() : int do
	return 5
end

groupSize = function() : int do
	return 1
end

# The level of a companion : the level of the wild Pokemon, give or take "levelSpread" (the offset is rolled)
levelSpread = function() : int do
	return 1
end

companionLevel = function(level: int, offset: int) : int do
	value = level + offset
	if value < 1
		return 1
	end
	return value
end

# How a wild Pokemon arrives on the map : "fly" (it flies in from out of the screen and lands on a free block near the
# player, it flies away after a while), "hideout" (it comes out of a hideout near the player : a bin, a bush, a log, a
# trunk), "grass" (out of tall grass), "water" (out of the water), "rock" (from behind a rock), "tree" (down from the
# leaves of a tree, on a silk thread), "walk" (it appears out of the screen). The flights and the hideouts :
# Data/Battle/arrivals.miniska. The birds fly : Roucool (16), Roucoups (17), Roucarnage (18), Piafabec (21), Rapasdepic
# (22) ; the rats hide : Rattata (19), Rattatac (20).
arrival = function(monster: int) : string do
	if monster == 16 || monster == 17 || monster == 18 || monster == 21 || monster == 22
		return "fly"
	end
	if monster == 19 || monster == 20
		return "hideout"
	end
	# Bulbizarre in the tall grass, Carapuce in the water, Salameche behind the rocks, Chenipan in the trees
	if monster == 1
		return "grass"
	end
	if monster == 7
		return "water"
	end
	if monster == 4
		return "rock"
	end
	if monster == 10
		return "tree"
	end
	return "walk"
end
