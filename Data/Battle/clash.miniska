# The clashes in the real time battle (ClashSystem) : the battle stops, a battleground as in the first games, rounds of
# the menu of the skills played as in those games ("Bulbizarre utilise Charge !"), then the real time goes on. Two ways
# to get one :
#   a clash : the Pokemon of the player and its opponent attack each other at once, close : both act, the faster first
#   an opening : the Pokemon of the player dodges an attack at the last moment : it acts alone in the first round, its
#   hits cannot miss
# Called by the battle (it cannot wait) ; the dice are rolled by the battle (roll : 0 .. 99).

# Two attacks at once, "distance" blocks apart : a clash ?
clash = function(distance: int, roll: int) : bool do
	if distance > 2
		return false
	end
	return roll < 60
end

# A dodge when the attack of the opponent was "left" milliseconds from going (its startup) : an opening ?
opening = function(left: int) : bool do
	return left <= 220
end

# In a clash, the Pokemon of the player acts first : the faster one (its speed against the speed of its opponent), a tie
# by the roll
first = function(speed: int, other: int, roll: int) : bool do
	if speed == other
		return roll < 50
	end
	return speed > other
end

# The least time between two turns (milliseconds of battle) : they stay rare
cooldown = function() : int do
	return 15000
end

# The rounds of a clash (a K.O. ends it sooner)
rounds = function() : int do
	return 3
end

# The battle time (milliseconds) a round stands for : the statuses and the changes of statistics wear off by it (a sleep
# of 3.5 s : 2 rounds), the statuses that hurt (poison, burn, leech) hurt once at the end of each round, as in the first
# games
roundTime = function() : int do
	return 2000
end

# After the first round, the skill of the opponent : "powers" the power of each of its skills (0 : one that does not hit),
# roll : 0 .. 99. Its strongest one time in two, else the first one that hits from the roll on (its index)
pick = function(powers: int[], roll: int) : int do
	best = 0
	for(i = 1
	 i < powers.size()
	 i = i + 1) do
		if powers[i] > powers[best]
			best = i
		end
	end
	if roll < 50 || powers.size() == 0
		return best
	end
	for(k = 0
	 k < powers.size()
	 k = k + 1) do
		i = (roll + k) % powers.size()
		if powers[i] > 0
			return i
		end
	end
	return best
end
