# The steps of a battle (BattleDirectorSystem) : the battle starts this script at each of its steps and waits for its end
# before going on. Arguments : the step, then
#   start : the name of the Pokemon of the player, the name and the level of the (first) wild Pokemon
#   knockout : "won" or "lost", the name of the Pokemon of the player, the name of the (first) wild Pokemon
#   fled : the name of the Pokemon of the player
# The dialogs before and after the battle come from "message" (called by the battle : it cannot wait).
Battle = import "bind:game.battle"
Engine = import "bind:ska.engine"

# The banner of a step : the big text in the middle of the screen ("" : none)
banner = function(args: string[]) : string do
	if args[0] == "start"
		return "COMBAT !"
	end
	if args[0] == "knockout"
		if args[1] == "won"
			return "VICTOIRE !"
		end
		return "K.O. !"
	end
	if args[0] == "fled"
		return "FUITE !"
	end
	return ""
end

# The line of a dialog of the battle : "intro" (it appears), "won", "lost", "fled" ; name : the wild Pokemon
message = function(step: string, name: string) : string do
	if step == "intro"
		return "Un " + name + " sauvage apparaît !"
	end
	if step == "won"
		return "Le " + name + " a été battu."
	end
	if step == "fled"
		return "Vous prenez la fuite !"
	end
	return "Votre Pokémon est K.O."
end

run = function(args: string[]) do
	text = banner(args)
	if text != ""
		Battle.announce(text)
	end
	# The K.O. : the banner stays during the slow motion
	if args[0] == "knockout"
		Engine.wait(1200)
	end
end
