# The arrival of a wild Pokemon near the player, when it does not walk in (Data/Battle/encounters.miniska "arrival") : the
# spawner of the map starts this script. A bird flies in and lands on a free block on the screen, it flies away after a
# while ; the others come out of a hideout on the screen (a property of its tile in the tileset) : a Rattata out of a
# bin, a bush, a log, a trunk ("hideout") ; a Bulbizarre out of tall grass ("grass") ; a Carapuce out of the water
# ("water") ; a Salameche from behind a rock ("rock") ; a Chenipan down from the leaves of a tree, on a silk thread
# ("tree") ; a Tentacool surfaces in the water, a splash, and stays in it ("swim" : the edge of the water is a wall for
# it). Nowhere to arrive : it walks in (a swimmer : it does not come). The dice are rolled by the game (the replays stay the same).
# Arguments : the arrival (the name of a value of Arrival), the monster, its level, its attitude, the block of the
# player (x, y), two rolls (0 .. 9999).
Battle = import "bind:game.battle"
Map = import "bind:game.map"

# How a wild Pokemon arrives (Data/Battle/encounters.miniska "arrival" gives the name of one)
Arrival = enum fly, hideout, grass, water, rock, tree, walk, swim end

# The properties of the tiles (the red channel of the .prop of a tileset : tools/worldgen/worldgen.py, tile_flags)
Water = 1
Hideout = 2
Grass = 4
Canopy = 8
Rock = 16
Layers = 3
# The blocks seen around the player (at the zoom of the map, about 17 x 10 blocks) ; not too close to it
SeenX = 6
SeenY = 3
Closest = 2
# A Pokemon comes out of its hideout after it rustled this long (ms)
Rustle = 700

# How long a bird stays on the ground before it flies away (ms ; "roll" : 0 .. 99). A fearful one flies away as soon as
# it sees the player.
stay = function(monster: int, roll: int) : int do
	return 12000 + 150 * roll
end

distance = function(x: int, y: int, px: int, py: int) : int do
	dx = x - px
	if dx < 0
		dx = 0 - dx
	end
	dy = y - py
	if dy < 0
		dy = 0 - dy
	end
	return dx + dy
end

# A block a wild Pokemon can stand on : no wall, nobody there, no water
standable = function(x: int, y: int) : bool do
	return Map.blockFree(x, y) && !Map.blockHasProperty(0, x, y, Water)
end

# A block a swimmer can surface on : free water (no rock in it, nobody there)
swimmable = function(x: int, y: int) : bool do
	return Map.blockFree(x, y) && Map.blockHasProperty(0, x, y, Water)
end

# The free water blocks seen around the player : x, y, x, y...
surfaces = function(px: int, py: int) : int[] do
	found = []: int
	y = py - SeenY
	while y <= py + SeenY do
		x = px - SeenX
		while x <= px + SeenX do
			if distance(x, y, px, py) >= Closest && swimmable(x, y)
				found = found + [x, y]
			end
			x = x + 1
		end
		y = y + 1
	end
	return found
end

# A tile of a layer of the block has the property (a hideout : Hideout, Grass, Water, Rock, Canopy)
has = function(x: int, y: int, property: int) : bool do
	layer = 0
	while layer < Layers do
		if Map.blockHasProperty(layer, x, y, property)
			return true
		end
		layer = layer + 1
	end
	return false
end

# A tile of a layer of the block is a hideout (a bin, a bush, a log, a trunk)
hideout = function(x: int, y: int) : bool do
	return has(x, y, Hideout)
end

# The property of the hideouts of an arrival, and what they throw while they rustle
property = function(kind: Arrival) : int do
	return match kind
		when Arrival.grass then Grass
		when Arrival.water then Water
		when Arrival.rock then Rock
		when Arrival.tree then Canopy
		else Hideout
	end
end

effect = function(kind: Arrival) : string do
	return match kind
		when Arrival.water then "splash"
		when Arrival.rock then "dust"
		else "leaves"
	end
end

# The free blocks seen around the player : x, y, x, y...
landings = function(px: int, py: int) : int[] do
	found = []: int
	y = py - SeenY
	while y <= py + SeenY do
		x = px - SeenX
		while x <= px + SeenX do
			if distance(x, y, px, py) >= Closest && standable(x, y)
				found = found + [x, y]
			end
			x = x + 1
		end
		y = y + 1
	end
	return found
end

# The hideouts of an arrival seen around the player, with the free block it comes out on : hideout x, y, then out x,
# y... A tree : its leaves, the block under its trunk (2 blocks lower : it comes down there). The others : south first
# (towards the player's side of the screen), then east, west, north
hidingPlaces = function(px: int, py: int, kind: Arrival) : int[] do
	found = []: int
	wanted = property(kind)
	# South, east, west, north : dx, dy
	sides = [0, 1, 1, 0, -1, 0, 0, -1]
	if kind == Arrival.tree
		sides = [0, 2]
	end
	y = py - SeenY
	while y <= py + SeenY do
		x = px - SeenX
		while x <= px + SeenX do
			if distance(x, y, px, py) >= Closest && has(x, y, wanted)
				side = 0
				while side < sides.size() do
					ox = x + sides[side]
					oy = y + sides[side + 1]
					# Down from a tree : onto a block in sight (no leaves of another tree over it)
					if standable(ox, oy) && !(kind == Arrival.tree && has(ox, oy, Canopy))
						found = found + [x, y, ox, oy]
						side = sides.size()
					else
						side = side + 2
					end
				end
			end
			x = x + 1
		end
		y = y + 1
	end
	return found
end

# The hideouts seen around the player (a bin, a bush, a log, a trunk), with the free block it comes out on (south first :
# towards the player's side of the screen) : hideout x, y, then out x, y...
hideouts = function(px: int, py: int) : int[] do
	return hidingPlaces(px, py, Arrival.hideout)
end

run = function(args: string[]) do
	kind = (args[0]: Arrival)
	monster = (args[1]: int)
	level = (args[2]: int)
	attitude = args[3]
	px = (args[4]: int)
	py = (args[5]: int)
	roll = (args[6]: int)
	stayRoll = (args[7]: int)
	if kind == Arrival.fly
		found = landings(px, py)
		if found.size() > 0
			i = (roll % (found.size() / 2)) * 2
			Battle.land(monster, level, attitude, found[i], found[i + 1], stay(monster, stayRoll % 100))
			return
		end
	end
	if kind == Arrival.swim
		found = surfaces(px, py)
		if found.size() > 0
			i = (roll % (found.size() / 2)) * 2
			Battle.emerge(monster, level, attitude, found[i], found[i + 1], found[i], found[i + 1], Rustle, "splash")
		end
		return
	end
	if kind != Arrival.fly && kind != Arrival.walk
		found = hidingPlaces(px, py, kind)
		if found.size() > 0
			i = (roll % (found.size() / 4)) * 4
			if kind == Arrival.tree
				Battle.drop(monster, level, attitude, found[i], found[i + 1], found[i + 2], found[i + 3], Rustle)
			else
				Battle.emerge(monster, level, attitude, found[i], found[i + 1], found[i + 2], found[i + 3], Rustle, effect(kind))
			end
			return
		end
	end
	Battle.walkIn(monster, level, attitude)
end
