# Goes to a map at a block, and waits for the map. Usage : ska-console run tools/agent/warp.miniska <map> <x> <y>
Engine = import "bind:ska.engine"
Dev = import "bind:ska.dev"
Map = import "bind:game.map"
Story = import "wd:Levels/story"

run = function(args: string[]) do
	if args.size() != 3
		Dev.reply("usage : warp.miniska <map> <x> <y> (maps : the folders of Levels)")
		return
	end
	map = args[0]
	Map.teleport(map, (args[1]: int), (args[2]: int))
	Map.waitTransition()
	player = Story.player()
	Dev.reply(Map.name() + " (" + (Map.blockX(player): string) + "," + (Map.blockY(player): string) + ")")
end
