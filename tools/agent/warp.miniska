# Goes to a map at a block, and waits for the map. Usage : ska-console run tools/agent/warp.miniska <map> <x> <y>
Engine = import "bind:ska.engine"
Dev = import "bind:ska.dev"
Map = import "bind:game.map"

run = function(args: string[]) do
	if args.size() != 3
		Dev.reply("usage : warp.miniska <map> <x> <y> (maps : the folders of Levels)")
		return
	end
	map = args[0]
	Map.teleport(map, (args[1]: int), (args[2]: int))
	Map.waitTransition()
	player = Engine.entity("trainer")
	x = Map.blockX(player)
	y = Map.blockY(player)
	# The block in the map (as the arguments), then in the world when it is another one
	reply = Map.name() + " (" + ((x - Map.originX()): string) + "," + ((y - Map.originY()): string) + ")"
	if Map.originX() != 0 || Map.originY() != 0
		reply = reply + " world (" + (x: string) + "," + (y: string) + ")"
	end
	Dev.reply(reply)
end
