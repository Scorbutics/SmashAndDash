# The game variables that are set (not 0), name=value. Usage : ska-console run tools/agent/variables.miniska [name prefix] [all]
Engine = import "bind:ska.engine"
Dev = import "bind:ska.dev"

startsWith = function(text: string, prefix: string) : bool do
	if text.size() < prefix.size()
		return false
	end
	i = 0
	same = true
	while same && i < prefix.size() do
		same = text[i] == prefix[i]
		i = i + 1
	end
	return same
end

run = function(args: string[]) do
	prefix = ""
	if args.size() > 0
		prefix = args[0]
	end
	all = args.size() > 1 && args[1] == "all"
	count = 0
	Engine.variables() | (line) do
		isZero = line.size() >= 2 && line[line.size() - 2] == "=" && line[line.size() - 1] == "0"
		if startsWith(line, prefix) && (all || !isZero)
			Dev.reply(line)
			count = count + 1
		end
	end
	if count == 0
		Dev.reply("no variable set (all : variables.miniska <prefix> all)")
	end
end
