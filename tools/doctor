#!/bin/sh
# doctor : runs the usage examples of the agent tools against the real game, so they fail loudly the day the game changes
# under them. Needs a build (cmake --build build) and Xvfb. Usage : tools/doctor [build directory, default build]
#   - tools/sad-run up/down : a run from a copy of save1 (its world, seed 7, generated in the copy), ready (console + skalang) ;
#     the title screen (--title) ;
#     a new game (a save not there : its world generated by the game, seed 42)
#   - ska-console : ping, eval (expression, statements), run tools/agent/*.miniska, shot, press, pause/step
#   - the tile room (tools/worldgen/tileroom.py) : every kind of tile shown, the walls of the game as the generator wants
#   - the saves of the repository are not written ; the logs of the run are in its folder
#   - tools/web/sad-web, when a web build (build-web) and Playwright (tools/web/node_modules) are there
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
BUILD=$(cd "${1:-$ROOT/build}" && pwd)
PATH="$ROOT/external/ska/tools:$PATH"
RUN=doctor-$$
FAILED=0
check() {
	# check <name> <expected text> <command...>
	name=$1; expected=$2; shift 2
	if out=$("$@" 2>&1) && printf '%s' "$out" | grep -q -- "$expected"; then
		echo "ok    $name"
	else
		echo "FAIL  $name : $* -> $out"
		FAILED=1
	fi
}
check_fails() {
	# check_fails <name> <expected text> <command...> : the command fails (exit 1), with the expected error
	name=$1; expected=$2; shift 2
	if out=$("$@" 2>&1); then
		echo "FAIL  $name : $* succeeded -> $out"
		FAILED=1
	elif printf '%s' "$out" | grep -q -- "$expected"; then
		echo "ok    $name"
	else
		echo "FAIL  $name : $* -> $out"
		FAILED=1
	fi
}
cd "$ROOT"
saves_before=$(find Data/Saves -type f -exec md5sum {} + | sort)
trap 'tools/sad-run down $RUN >/dev/null 2>&1 || true' EXIT

check "sad-run up (save1)" '"ready_ms"' tools/sad-run up $RUN --save save1 --build "$BUILD"
check "ping" '"evaluator": true' ska-console --run $RUN ping
check "eval expression" '"value": "4"' ska-console --run $RUN eval '2 + 2'
check "eval statements that wait" '"value": "waited"' ska-console --run $RUN eval 'Engine.wait(200)
Dev.reply("waited")'
check_fails "eval compile error (line of the code)" 'l.1, c.6) Symbol not found : Nope' ska-console --run $RUN eval 'Nope.call()'
check "map name (game prelude)" '"value": "w_5_4"' ska-console --run $RUN eval 'Map.name()'
check "state" 'states=WorldState' ska-console --run $RUN run external/ska/tools/agent/state.miniska
check "entities" 'trainer' ska-console --run $RUN run external/ska/tools/agent/entities.miniska trainer
check "party" 'pokemon' ska-console --run $RUN run tools/agent/party.miniska
check "variables" '"ok": true' ska-console --run $RUN run tools/agent/variables.miniska
check "spawn (a wild Pokemon arrives)" 'arriving' ska-console --run $RUN run tools/agent/spawn.miniska 19 3
check "wild" 'wild pokemon' ska-console --run $RUN run tools/agent/wild.miniska
check "warp" 'w_room_0 (11,8)' ska-console --run $RUN run tools/agent/warp.miniska w_room_0 11 8
# Outdoors the chunks are one map : walking east from w_5_4 into w_6_4, no transition, nothing stops the player
check "warp by a chunk border" 'w_5_4 (38,20) world (238,180)' ska-console --run $RUN run tools/agent/warp.miniska w_5_4 38 20
check "walk across it" '"pressed"' ska-console --run $RUN press D 60
check "in the next chunk" '"value": "w_6_4 ' ska-console --run $RUN eval 'p = Engine.entity("trainer")
Dev.reply(Map.name() + " " + (Map.blockX(p): string))'
check "chunks come" 'Chunk load w_6_4' ska-run logs $RUN --grep 'Chunk load w_6_4'
# The tile room (tools/worldgen/tileroom.py) : every tile of the generator on a map of the run, its walls in the game
WORLD="${SKA_RUNS_DIR:-/tmp/ska-runs-$(id -u)}/$RUN/Saves/save1/World"
check "tile room : every kind of tile" 'w_tiles : ' python3 tools/worldgen/tileroom.py "$WORLD"
check "tile room : warp" 'w_tiles (1,1)' ska-console --run $RUN run tools/agent/warp.miniska w_tiles 1 1
WALLS="${SKA_RUNS_DIR:-/tmp/ska-runs-$(id -u)}/$RUN/walls.json"
ska-console --run $RUN run tools/agent/walls.miniska 52 54 > "$WALLS" 2>&1 || true
check "tile room : the walls of the game (walls.miniska)" 'the game blocks what the generator blocks' \
	python3 tools/worldgen/tileroom.py --walls "$WALLS" --at 1 1
check "shot" '"w": ' ska-console --run $RUN shot doctor
check "press" '"pressed"' ska-console --run $RUN press D 10
check "pause" 'paused' ska-console --run $RUN pause
check "step" '"frames": 5' ska-console --run $RUN step 5
check "resume" 'resumed' ska-console --run $RUN resume
check "logs in the run folder" 'Random seed' ska-run logs $RUN --grep 'Random seed'
check "sad-run down" '"exit": 0' tools/sad-run down $RUN
trap - EXIT
tools/sad-run rm $RUN >/dev/null 2>&1 || true

# The title screen (no save given) : the saves listed, a new game
TITLE=doctor-title-$$
trap 'tools/sad-run down $TITLE >/dev/null 2>&1 || true' EXIT
check "sad-run up --title" '"ready_ms"' tools/sad-run up $TITLE --title --build "$BUILD"
check "title : the title screen" '"state": "StateTitle"' ska-console --run $TITLE ping
check "title : shot" '"w": ' ska-console --run $TITLE shot title
check "title : sad-run down" '"exit": 0' tools/sad-run down $TITLE
trap - EXIT
tools/sad-run rm $TITLE >/dev/null 2>&1 || true

# A new game : a save that is not there, its world generated in it (seed 42 : the world of save2, w_0_4)
NEW=doctor-new-$$
trap 'tools/sad-run down $NEW >/dev/null 2>&1 || true' EXIT
check "sad-run up (a new game, seed 42)" '"ready_ms"' tools/sad-run up $NEW --save doctor_new_game --build "$BUILD" --env SAD_WORLD_SEED=42
check "new game : its world generated (loading screen)" 'is generated' ska-run logs $NEW --grep 'world of doctor_new_game is generated'
check "new game : it starts in the village" '"value": "w_0_4"' ska-console --run $NEW eval 'Map.name()'
check "new game : sad-run down" '"exit": 0' tools/sad-run down $NEW
trap - EXIT
tools/sad-run rm $NEW >/dev/null 2>&1 || true

if [ "$(find Data/Saves -type f -exec md5sum {} + | sort)" = "$saves_before" ]; then
	echo "ok    the saves of the repository are untouched"
else
	echo "FAIL  the run wrote into Data/Saves"
	FAILED=1
fi

if [ -f "$ROOT/build-web/game/bin/index.html" ] && [ -d "$ROOT/tools/web/node_modules/playwright" ]; then
	WEB=doctor-web-$$
	check "sad-web up" '"frames"' tools/web/sad-web up $WEB --env SAD_BATTLE_PASSIVE=1
	check "sad-web shot" '"path"' tools/web/sad-web shot $WEB start
	check "sad-web eval" '"value"' tools/web/sad-web eval $WEB 'Module.skaFrames'
	check "sad-web down" '"stopped":true' tools/web/sad-web down $WEB
else
	echo "skip  sad-web (no build-web, or npm install --prefix tools/web)"
fi
exit $FAILED
