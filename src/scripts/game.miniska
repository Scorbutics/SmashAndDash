# Game functions available to the scripts : Game = import "bind:game"
# Directions : 0 down, 1 right, 2 up, 3 left (4 to 7 : diagonals)

# Moves an entity in a direction over a distance (pixels), through the obstacles when "ghost" is true.
# The script waits until the movement is done.
move = function(entity: int, direction: int, distance: int, ghost: bool) do end
jump = function(entity: int, power: int) do end

# Shows a message : the script waits until the player closes it
message = function(text: string) do end

# Goes to a map, at a block position
teleport = function(map: string, x: int, y: int) do end

# Adds a character (sprite, block position, name) : "script" runs with its arguments when the player talks to it
# ("" : no script). Returns the character entity.
addCharacter = function(sprite: int, x: int, y: int, name: string, script: string, arguments: string[]) : int do return 0 end

# Plays an animation (sprite of the animations bank) over an entity
playAnimation = function(entity: int, animation: int) do end
# Direction an entity looks to
direction = function(entity: int) : int do return 0 end
setDirection = function(entity: int, direction: int) do end
# Layer an entity is on (0 : ground, 1 : over the water...)
setLayer = function(entity: int, layer: int) do end

# Block an entity is on
blockX = function(entity: int) : int do return 0 end
blockY = function(entity: int) : int do return 0 end
# The block of a layer at a block position has a property (bit mask)
blockHasProperty = function(layer: int, x: int, y: int, property: int) : bool do return false end
