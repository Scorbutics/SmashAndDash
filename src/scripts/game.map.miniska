# Maps : teleportation, blocks, map effects : Map = import "bind:game.map"
# Directions : 0 down, 1 right, 2 up, 3 left (4 to 7 : diagonals)

# Name of the current map (ex : "Town")
name = function() : string do return "" end

# Goes to a map, at a block position (the map changes during a screen transition : waitTransition waits for its end).
# During a battle : an error of the script (the map does not change under a battle)
teleport = function(map: string, x: int, y: int) do end
# Waits until the screen transition (a map change) is over
waitTransition = function() do end

# Block an entity is on
blockX = function(entity: int) : int do return 0 end

blockY = function(entity: int) : int do return 0 end

# The block of a layer at a block position has a property (bit mask : 1 water, 2 a hideout of the wild Pokemon, 4 tall
# grass, 8 the leaves of a tree, 16 a rock ; the generated worlds, tools/worldgen tile_flags)
blockHasProperty = function(layer: int, x: int, y: int, property: int) : bool do return false end

# Nothing at a block position where a character stands on it (the middle of its lower half) : no solid part of a tile,
# no character (the water is free, blockHasProperty tells it). Out of the map : false
blockFree = function(x: int, y: int) : bool do return false end

# Shakes the camera during "duration" milliseconds, up to "intensity" pixels (less and less). The script does not wait.
shake = function(duration: int, intensity: int) do end

# Not available in this version of the game (logged, nothing is done)
crumbling = function(duration: int) do end
