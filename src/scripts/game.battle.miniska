# Battles : Battle = import "bind:game.battle"
# The rules of the battles (statistics, damage), the behaviour of the wild Pokemon and the steps of a battle (its banners,
# its dialogs : Data/Battle/steps.miniska) are scripts : Data/Battle.
# Hooks : Engine.on("battle.won", ...), Engine.on("battle.lost", ...) and Engine.on("battle.fled", ...) are called at the end
# of each battle (with the player). The player flees a battle by leaving the arena for 1 second.

# Starts a battle against a wild Pokemon (Data/Monsters/<monster>.ini) of a level, with the first Pokemon of the team.
# The script waits until the end of the battle, back on the map : true when the player won (false : lost or fled).
# false right away (no battle) when no Pokemon of the team can fight.
# After the battle, the hit points left and the experience won are saved in the team.
start = function(monster: int, level: int) : bool do return false end

# Starts a battle against a group of wild Pokemon : "monsters" (Data/Monsters/<monster>.ini) and their "levels" (one each).
# They all fight the Pokemon of the player ; the battle is won when they are all K.O. "canFlee" : false for a story
# battle (the arena cannot be left). The script waits as with start.
startWith = function(monsters: int[], levels: int[], canFlee: bool) : bool do return false end

# A message of the battle, in the dialog window : the script waits until the player closes it (it closes by itself with
# SAD_BATTLE_AUTOPLAY). For the steps of the battles (Data/Battle/steps.miniska : the outro)
message = function(text: string) do end

# A banner over the battle going on (big text in the middle of the screen) ; nothing out of a battle. For the steps of
# the battles (Data/Battle/steps.miniska)
announce = function(text: string) do end

# The wild Pokemon on the map, one line each : "<monster> <level> <block x> <block y> <attitude>" (attitude : aggressive,
# fearful, passive : Data/Battle/encounters.miniska)
wild = function() : string[] do return []: string end

# Number of battles since the game started, result of the last one
battles = function() : int do return 0 end
lastWon = function() : bool do return false end
lastFled = function() : bool do return false end
