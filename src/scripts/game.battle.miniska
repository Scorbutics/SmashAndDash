# Battles : Battle = import "bind:game.battle"
# The rules of the battles (statistics, damage), the behaviour of the wild Pokemon and the steps of a battle (its banners,
# its dialogs : Data/Battle/steps.miniska) are scripts : Data/Battle.
# Hooks : Engine.on("battle.won", ...), Engine.on("battle.lost", ...) and Engine.on("battle.fled", ...) are called at the end
# of each battle (with the player). The player flees a battle by leaving the arena for 1 second.

# Starts a battle against a wild Pokemon (Data/Monsters/<monster>.ini) of a level, with the first Pokemon of the team.
# The script waits until the end of the battle, back on the map : true when the player won (false : lost or fled).
# false right away (no battle) when no Pokemon of the team can fight.
# After the battle, the hit points left and the experience won are saved in the team.
start = function(monster: int, level: int) : bool do return false end

# Starts a battle against a group of wild Pokemon : "monsters" (Data/Monsters/<monster>.ini) and their "levels" (one each).
# They all fight the Pokemon of the player ; the battle is won when they are all K.O. "canFlee" : false for a story
# battle (the arena cannot be left). The script waits as with start.
startWith = function(monsters: int[], levels: int[], canFlee: bool) : bool do return false end
# The difficulty of the AI of the next battle started by a script (0 easy, as the wild Pokemon ; 1 normal ; 2 hard : a
# trainer that is a challenge, a gym leader). Back to easy at the end of the battle
difficulty = function(level: int) do end

# A message of the battle, in the dialog window : the script waits until the player closes it (it closes by itself with
# SAD_BATTLE_AUTOPLAY). For the steps of the battles (Data/Battle/steps.miniska : the outro)
message = function(text: string) do end

# A banner over the battle going on (big text in the middle of the screen) ; nothing out of a battle. For the steps of
# the battles (Data/Battle/steps.miniska)
announce = function(text: string) do end

# The evolution of the Pokemon of the team at "index" into the species "into", shown over the battle as in the first games
# (the light, the two forms that alternate, the flash, the new form) : the script waits for its end (7 s). Only the scene :
# Party.evolve changes the Pokemon. False at once : no battle. For the outro of the battles (Data/Battle/steps.miniska)
evolve = function(index: int, into: int) : bool do return false end

# A clash now in the battle going on (as when the two Pokemon attack each other at once, close) : the dev tools, the
# tests. The script does not wait. False : no battle, or not fighting (its start, its end, a clash already)
clash = function() : bool do return false end

# The wild Pokemon on the map, one line each : "<monster> <level> <block x> <block y> <attitude>" (attitude : aggressive,
# fearful, passive : Data/Battle/encounters.miniska)
wild = function() : string[] do return []: string end

# A wild Pokemon arrives near the player (from the next frame), as Data/Battle/encounters.miniska wants it ("arrival" :
# flying in, out of a hideout, walking in from out of the screen) ; it is in Battle.wild() once arrived. False : no player
spawnWild = function(monster: int, level: int) : bool do return false end

# The arrivals of the wild Pokemon (Data/Battle/arrivals.miniska ; the script does not wait, the wild Pokemon is in
# Battle.wild() once arrived). False : no player on the map. Attitude : "aggressive", "fearful", "passive".
# A bird flies in from out of the screen (beyond the block, seen from the player), lands on the block, flies away after
# "stay" ms (0 : it stays ; a fearful one flies away as soon as it sees the player)
land = function(monster: int, level: int, attitude: string, x: int, y: int, stay: int) : bool do return false end
# The hideout (a block) rustles "rustle" ms, then the Pokemon hops out of it onto the block x, y. "effect" : what the
# hideout throws while it rustles ("leaves" : a bush, a bin, tall grass ; "dust" : a rock ; "splash" : the water)
emerge = function(monster: int, level: int, attitude: string, hideoutX: int, hideoutY: int, x: int, y: int, rustle: int, effect: string) : bool do return false end
# The leaves of a tree (a block) rustle "rustle" ms, then the Pokemon comes down from them on a silk thread onto the
# block x, y (under the tree)
drop = function(monster: int, level: int, attitude: string, leavesX: int, leavesY: int, x: int, y: int, rustle: int) : bool do return false end
# It walks in from out of the screen (false : no room for it)
walkIn = function(monster: int, level: int, attitude: string) : bool do return false end

# Number of battles since the game started, result of the last one
battles = function() : int do return 0 end
lastWon = function() : bool do return false end
lastFled = function() : bool do return false end
