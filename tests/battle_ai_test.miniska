# Behaviour of the wild Pokemon (Data/Battle/ai.miniska)
Test = import "bind:std.native.test"
Engine = import "bind:ska.engine"
AI = import "wd:Data/Battle/ai"

run = function(args: string[]) do
	Engine.setNextRandom(1)
	Test.equal((AI.decide(16, 7, 10, 10, [true]): string), "-1", "too far : no skill")
	Test.equal((AI.decide(16, 2, 10, 10, [false, false]): string), "-1", "no skill ready")
	Test.equal((AI.decide(16, 2, 10, 10, [true, false, true]): string), "2", "one of the ready skills, chosen at random")
	Test.equal((AI.decide(16, 2, 10, 10, [false, true]): string), "1", "the only ready skill")
	Engine.setNextRandom(0)
	Test.equal((AI.decide(16, 2, 10, 10, [true]): string), "-1", "it hesitates sometimes")
end
