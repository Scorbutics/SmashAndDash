# Battle rules (Data/Battle/rules.miniska)
Test = import "bind:std.native.test"
Rules = import "wd:Data/Battle/rules"

run = function(args: string[]) do
	Test.equal((Rules.stat(55, 5): string), "10", "a statistic at a level")
	Test.equal((Rules.maxHp(35, 5): string), "36", "hit points at a level (twice the usual value : real time battles)")
	Test.equal((Rules.level(41, 13): string), "4", "level from the experience")
	Test.equal((Rules.level(0, 0): string), "1", "no experience needed : level 1")
	Test.equal((Rules.level(99999, 1): string), "100", "level 100 at most")
	Test.equal((Rules.levelExperience(4, 13): string), "39", "the experience at the start of a level")
	Test.equal((Rules.level(Rules.levelExperience(4, 13), 13): string), "4", "it is that level")
	Test.equal((Rules.levelExperience(1, 13): string), "0", "level 1 : no experience")
	Test.equal((Rules.damage(0, 50, 5, 10, 100, false): string), "0", "a skill without power does no damage")
	Test.equal((Rules.damage(4, 8, 7, 4, 100, false): string), "1", "at least 1 damage with power")
	Test.equal((Rules.damage(15, 10, 10, 5, 100, false): string), "5", "a skill of power 15 at level 5")
	Test.equal((Rules.damage(15, 10, 10, 5, 100, true): string), "7", "the type of the attacker : +50%")
	Test.equal((Rules.damage(15, 10, 10, 5, 200, false): string), "10", "super effective : twice the damage")
	Test.equal((Rules.damage(15, 10, 10, 5, 0, false): string), "0", "no effect : no damage")
	Test.check(Rules.damage(15, 10, 10, 20, 100, false) > Rules.damage(15, 10, 10, 5, 100, false), "a higher level hits harder")
	Test.check(Rules.damage(15, 30, 5, 20, 100, false) > Rules.damage(15, 30, 20, 20, 100, false), "more defense, less damage")
	Test.check(Rules.damage(15, 30, 0, 20, 100, false) > 0, "no defense : no division by zero")
	Test.equal((Rules.effectiveness("Eau", "Feu", "Aucun"): string), "200", "water on fire : super effective")
	Test.equal((Rules.effectiveness("Electrique", "Eau", "Vol"): string), "400", "two weak types : four times")
	Test.equal((Rules.effectiveness("Plante", "Feu", "Aucun"): string), "50", "grass on fire : not very effective")
	Test.equal((Rules.effectiveness("Electrique", "Sol", "Aucun"): string), "0", "electric on ground : no effect")
	Test.equal((Rules.effectiveness("Normal", "Normal", "Aucun"): string), "100", "no relation : normal")
	Test.equal((Rules.experience(10, 3): string), "30", "experience won")
end
