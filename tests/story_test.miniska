# Story helpers (Levels/story.miniska)
Test = import "bind:std.native.test"
Engine = import "bind:ska.engine"
Story = import "wd:Levels/story"

run = function(args: string[]) do
	Test.check(!Story.done(3), "a step not done")
	Story.setDone(3)
	Test.check(Story.done(3), "a step done")
	Test.check(!Story.done(4), "the other steps are not done")
	Test.equal((Engine.variable("story3"): string), "1", "saved in the game variables")

	Engine.setEntity("trainer", 5)
	Engine.setEntity("npc-4_0", 12)
	Test.equal((Story.player(): string), "5", "the player")
	Test.equal((Story.npc(4, 0): string), "12", "a character by its sprite and index")
	Test.equal((Story.npc(4, 1): string), "-1", "no such character")
end
