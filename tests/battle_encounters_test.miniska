# Encounters and skills known (Data/Battle/encounters.miniska, Data/Battle/skills.miniska)
Test = import "bind:std.native.test"
Encounters = import "wd:Data/Battle/encounters"
Skills = import "wd:Data/Battle/skills"

run = function(args: string[]) do
	Test.equal(Encounters.attitude(25, 5, 5, 0), "aggressive", "the low rolls : aggressive")
	Test.equal(Encounters.attitude(25, 5, 5, 45), "fearful", "then fearful")
	Test.equal(Encounters.attitude(25, 5, 5, 80), "passive", "then passive")
	Test.equal(Encounters.attitude(25, 9, 3, 65), "aggressive", "much stronger than the team : aggressive more often")
	Test.equal(Encounters.attitude(25, 2, 8, 50), "fearful", "much weaker : fearful more often")
	Test.equal(Encounters.arrival(16), "fly", "Roucool flies in")
	Test.equal(Encounters.arrival(19), "hideout", "Rattata comes out of a hideout")
	Test.equal(Encounters.arrival(25), "walk", "Pikachu walks in")
	Test.equal((Encounters.stay(16, 0): string), "12000", "a bird stays 12 s at least")
	Test.equal((Encounters.groupOdds(): string), "5", "a group 1 time in 5")
	Test.equal((Encounters.companionLevel(1, -1): string), "1", "at least level 1")
	Test.equal((Encounters.companionLevel(4, 1): string), "5", "one level more")
	levels = [1, 1, 5, 3, 9, 4]
	Test.equal((Skills.knownCount(levels, 2, 4): string), "2", "two skills at level 2")
	Test.equal((Skills.known(levels, 2, 4, 1): string), "1", "in the order of the data")
	Test.equal((Skills.knownCount(levels, 9, 4): string), "4", "four at most")
	Test.equal((Skills.known(levels, 9, 4, 0): string), "3", "the last four learned : level 3 first")
	Test.equal((Skills.known(levels, 9, 4, 3): string), "4", "the one of level 9 last")
end
