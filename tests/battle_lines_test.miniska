# The lines of the trainer during a battle (Data/Battle/lines.miniska)
Test = import "bind:std.native.test"
Lines = import "wd:Data/Battle/lines"

run = function(args: string[]) do
	Test.equal(Lines.line("start", "Bulbizarre", "", 99, 0), "Bulbizarre, go !", "the start always gets its line")
	Test.equal(Lines.line("start", "Bulbizarre", "", 0, 4), "En avant, Bulbizarre !", "pick chooses the line")
	Test.equal(Lines.line("attack", "Bulbizarre", "Charge", 29, 0), "Bulbizarre, Charge !", "under the chance : a line")
	Test.equal(Lines.line("attack", "Bulbizarre", "Charge", 30, 0), "", "at the chance : nothing")
	Test.equal(Lines.line("super", "Bulbizarre", "", 99, 0), "C'est super efficace !", "a super effective hit")
	Test.equal(Lines.line("ball", "Bulbizarre", "Poké Ball", 0, 0), "Poké Ball, go !", "the item named")
	Test.equal(Lines.line("unknown", "Bulbizarre", "", 0, 0), "", "an unknown event : nothing")
	Test.equal((Lines.pause("knockout"): string), "0", "a knock out is always commented")
	Test.equal((Lines.pause("hit"): string), "2800", "a hit waits for the last line")
end
