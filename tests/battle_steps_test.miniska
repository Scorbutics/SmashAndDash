# The steps of a battle (Data/Battle/steps.miniska)
Test = import "bind:std.native.test"
Battle = import "bind:game.battle"
GameDialog = import "bind:game.dialog"
Party = import "bind:game.party"
Steps = import "wd:Data/Battle/steps"

run = function(args: string[]) do
	Steps.run(["start", "PIKACHU", "RATTATA", "3"])
	Steps.run(["knockout", "won", "PIKACHU", "RATTATA"])
	Steps.run(["knockout", "lost", "PIKACHU", "RATTATA"])
	Steps.run(["fled", "PIKACHU"])
	shown = Battle.announced()
	Test.equal((shown.size(): string), "4", "a banner for each step")
	Test.equal(shown[0], "COMBAT !", "the start")
	Test.equal(shown[1], "VICTOIRE !", "a knock out won")
	Test.equal(shown[2], "K.O. !", "a knock out lost")
	Test.equal(shown[3], "FUITE !", "fled")
	Test.equal(Steps.message("intro", "Rattata"), "Un Rattata sauvage apparaît !", "the intro dialog")
	Test.equal(Steps.message("won", "Rattata"), "Le Rattata a été battu.", "the dialog of a battle won")

	# The outro : its dialogs, no banner
	Steps.run(["outro", "won", "PIKACHU", "Rattata", "24", "5", "6"])
	said = Battle.messages()
	Test.equal((said.size(): string), "3", "won with a level up : three dialogs")
	Test.equal(said[0], "Le Rattata a été battu.", "the battle won")
	Test.equal(said[1], "PIKACHU gagne 24 points d'expérience !", "the experience")
	Test.equal(said[2], "PIKACHU monte au niveau 6 !", "the new level")
	Steps.run(["outro", "fled", "PIKACHU", "Rattata", "0", "5", "5"])
	Test.equal((Battle.messages().size(): string), "3", "fled : no dialog (its banner said it)")
	Steps.run(["outro", "lost", "PIKACHU", "Rattata", "0", "5", "5"])
	Test.equal(Battle.messages()[3], "Votre Pokémon est K.O.", "lost")
	Test.equal((Battle.announced().size(): string), "4", "no banner in the outro")

	# A capture : its banner, its dialog
	Steps.run(["knockout", "captured", "PIKACHU", "Roucool"])
	Test.equal(Battle.announced()[4], "CAPTURÉ !", "the last wild Pokemon captured")
	Steps.run(["outro", "captured", "PIKACHU", "Roucool", "9", "5", "5"])
	Test.equal(Battle.messages()[4], "Roucool rejoint votre équipe !", "it joins the team")
	Test.equal(Battle.messages()[5], "PIKACHU gagne 9 points d'expérience !", "the experience of a capture")

	# A level up : the skills learned at the new levels. Room in the moveset : learned at once
	Party.setKnown([0, 1])
	Party.setLearning([2])
	Steps.run(["outro", "won", "BULBIZARRE", "Rattata", "30", "6", "7", "0"])
	said = Battle.messages()
	Test.equal(said[said.size() - 1], "BULBIZARRE apprend Fouet Lianes !", "a skill learned in a free slot")
	Test.equal(Party.skills(0)[2], "Fouet Lianes", "it is in the moveset")

	# 4 skills already : the player forgets one (the second), the new one takes its place
	Party.setKnown([0, 1, 2, 3])
	Party.setLearning([4])
	GameDialog.answer(true)
	GameDialog.choose(1)
	Steps.run(["outro", "won", "BULBIZARRE", "Rattata", "30", "7", "8", "0"])
	said = Battle.messages()
	Test.equal(said[said.size() - 1], "BULBIZARRE oublie Rugissement et apprend Tranch'Herbe !", "the skill forgotten for the new one")
	Test.equal(Party.skills(0)[1], "Tranch'Herbe", "in the place of the one forgotten")

	# The player does not want it
	Party.setLearning([5])
	GameDialog.answer(false)
	Steps.run(["outro", "won", "BULBIZARRE", "Rattata", "30", "8", "9", "0"])
	said = Battle.messages()
	Test.equal(said[said.size() - 1], "BULBIZARRE n'apprend pas Poudre Toxik.", "not learned")
	Test.equal((Party.skills(0).size(): string), "4", "the moveset is the same")
end
