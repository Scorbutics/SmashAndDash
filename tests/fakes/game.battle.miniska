# Fake of the battles for the headless script tests : the banners and the messages are recorded.
shown = []: string
said = []: string

start = function(monster: int, level: int) : bool do return false end
startWith = function(monsters: int[], levels: int[], canFlee: bool) : bool do return false end
announce = function(text: string) do
	shown = shown + text
end
message = function(text: string) do
	said = said + text
end
scenes = []: int
evolve = function(index: int, into: int) : bool do
	scenes = scenes + into
	return true
end
wild = function() : string[] do return []: string end
spawnWild = function(monster: int, level: int) : bool do return false end
arrived = []: string
land = function(monster: int, level: int, attitude: string, x: int, y: int, stay: int) : bool do
	arrived = arrived + ("land " + (monster: string) + " " + attitude + " " + (x: string) + " " + (y: string) + " " + (stay: string))
	return true
end
emerge = function(monster: int, level: int, attitude: string, hideoutX: int, hideoutY: int, x: int, y: int, rustle: int, effect: string) : bool do
	arrived = arrived + ("emerge " + (monster: string) + " " + (hideoutX: string) + " " + (hideoutY: string) + " " + (x: string) + " " + (y: string) + " " + effect)
	return true
end
drop = function(monster: int, level: int, attitude: string, leavesX: int, leavesY: int, x: int, y: int, rustle: int) : bool do
	arrived = arrived + ("drop " + (monster: string) + " " + (leavesX: string) + " " + (leavesY: string) + " " + (x: string) + " " + (y: string))
	return true
end
difficulty = function(level: int) do end
walkIn = function(monster: int, level: int, attitude: string) : bool do
	arrived = arrived + ("walk " + (monster: string))
	return true
end
battles = function() : int do return 0 end
lastWon = function() : bool do return false end
lastFled = function() : bool do return false end

# Test controls (only in the fake)
announced = function() : string[] do
	return shown
end
messages = function() : string[] do
	return said
end
# The evolutions shown (their species)
evolutions = function() : int[] do
	return scenes
end
# The arrivals asked (land, emerge, walkIn), as texts
arrivals = function() : string[] do
	return arrived
end
