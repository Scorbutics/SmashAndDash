# Fake of the dialogs for the headless script tests : the answers to the questions are given by the test, the messages
# and questions are recorded.

answers = []: bool
nextAnswer = 0
shown = []: string

message = function(text: string) do
	shown = shown + text
end

choice = function(question: string) : bool do
	shown = shown + question
	answer = false
	if nextAnswer < answers.size()
		answer = answers[nextAnswer]
	end
	nextAnswer = nextAnswer + 1
	return answer
end

picks = []: int
nextPick = 0

select = function(question: string, choices: string[]) : int do
	shown = shown + question
	pick = -1
	if nextPick < picks.size()
		pick = picks[nextPick]
	end
	nextPick = nextPick + 1
	return pick
end

cinematic = function(animation: int, text: string) do
	shown = shown + text
end

# Test controls (only in the fake)
answer = function(value: bool) do
	answers = answers + value
end
choose = function(index: int) do
	picks = picks + index
end

messages = function() : string[] do
	return shown
end
